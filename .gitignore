
# Distribution / packaging
.Python
__pycache__
*.egg-info/

# Virtual environments
.env/
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Unit test / coverage reports
.pytest_cache/
.coverage
# pytest-xdist writes one .coverage.<host>.<pid>.<rand> per worker, and the
# suite is parallel by default — unignored, they land in every `git add -A`.
.coverage.*
coverage.xml
htmlcov/


# Jupyter Notebook checkpoints
.ipynb_checkpoints

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo
*~

# Local environment files (the app reads real env vars only; never commit these)
.env
.env.*
.DS_Store

# Database files
*.db
*.sqlite
*.sqlite3

# File storage / local app state
storage/
uploads/
config/

# Logs
*.log
logs/

# ruff
.ruff_cache/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# Frontend artifacts
# Unqualified so a tool run from the repo root (vitest writes its cache to
# ./node_modules/.vite) cannot commit a node_modules tree that only the
# frontend/ prefix would have covered.
node_modules/
frontend/node_modules/
frontend/.next/
frontend/.next-sandbox/
frontend/.turbo/
frontend/out/
frontend/.vercel/
frontend/.cache/

# External API documentation downloads (fetch via scripts/download-*-docs.mjs)
docs/external-api/

# Local agent working files (keep local, never commit)
.superpowers/
docs/superpowers/
.playwright-mcp/

# Sandbox scenario harness (docs/sandbox.md)
.sandbox/
.env.sandbox
!.env.sandbox.example
frontend/test-results/
frontend/playwright-report/
.claude/specs/

# Parallel-gate logs (make gate)
gate-backend.log
gate-frontend.log
gate-backend.exit
gate-frontend.exit

# Narrowed README capture previews (make readme-assets SCENE=/THEME=)
frontend/.capture-preview/
