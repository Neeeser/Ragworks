  {
    "id": "count",
    "label": "Count matches",
    "definition": {
      "nodes": [
        {
          "id": "query-input",
          "type": "retrieval.input",
          "name": "Query",
          "config": {
            "tool_name": "count_matches",
            "tool_description": "Count documents and chunks that lexically match the query terms."
          }
        },
        {
          "id": "aggregate",
          "type": "count.bm25",
          "name": "Count",
          "config": {
            "backend": "pgvector",
            "index_name": "ragworks-bm25"
          }
        },
        {
          "id": "tool-output",
          "type": "tool.output",
          "name": "Tool Output",
          "config": {}
        }
      ],
      "edges": [
        {
          "id": "edge-input-aggregate",
          "source": "query-input",
          "target": "aggregate",
          "source_port": "items",
          "target_port": "items"
        },
        {
          "id": "edge-aggregate-output",
          "source": "aggregate",
          "target": "tool-output",
          "source_port": "values",
          "target_port": "values"
        }
      ],
      "viewport": {}
    }
  },
