[
  {
    "id": "semantic-keyword",
    "label": "Semantic + keyword search",
    "definition": {
      "nodes": [
        {
          "id": "query-input",
          "type": "retrieval.input",
          "name": "Retrieval Input",
          "config": {
            "arguments": [
              "result_limit"
            ]
          }
        },
        {
          "id": "embed-query",
          "type": "embedder.text",
          "name": "Embedder",
          "config": {
            "connection_id": "00000000-0000-0000-0000-000000000001",
            "model_name": "openai/text-embedding-3-small"
          }
        },
        {
          "id": "vector-retriever",
          "type": "retriever.vector",
          "name": "Semantic Retriever",
          "config": {
            "backend": "pgvector",
            "index_name": "ragworks",
            "top_k": {
              "$expr": "result_limit"
            }
          }
        },
        {
          "id": "retrieval-output",
          "type": "retrieval.output",
          "name": "Retrieval Output",
          "config": {}
        },
        {
          "id": "bm25-retriever",
          "type": "retriever.bm25",
          "name": "BM25 Retriever",
          "config": {
            "backend": "pgvector",
            "index_name": "ragworks-bm25",
            "top_k": {
              "$expr": "result_limit"
            }
          }
        },
        {
          "id": "fuse-results",
          "type": "fusion.rrf",
          "name": "RRF Fusion",
          "config": {}
        },
        {
          "id": "limit-results",
          "type": "limit.results",
          "name": "Result Limit",
          "config": {
            "max_results": {
              "$expr": "result_limit"
            }
          }
        }
      ],
      "edges": [
        {
          "id": "edge-retrieval-input",
          "source": "query-input",
          "target": "embed-query",
          "source_port": "items",
          "target_port": "items"
        },
        {
          "id": "edge-retrieval-embedder",
          "source": "embed-query",
          "target": "vector-retriever",
          "source_port": "items",
          "target_port": "items"
        },
        {
          "id": "edge-input-bm25-retriever",
          "source": "query-input",
          "target": "bm25-retriever",
          "source_port": "items",
          "target_port": "items"
        },
        {
          "id": "edge-semantic-fusion",
          "source": "vector-retriever",
          "target": "fuse-results",
          "source_port": "items",
          "target_port": "items"
        },
        {
          "id": "edge-bm25-fusion",
          "source": "bm25-retriever",
          "target": "fuse-results",
          "source_port": "items",
          "target_port": "items"
        },
        {
          "id": "edge-fusion-limit",
          "source": "fuse-results",
          "target": "limit-results",
          "source_port": "items",
          "target_port": "items"
        },
        {
          "id": "edge-limit-output",
          "source": "limit-results",
          "target": "retrieval-output",
          "source_port": "items",
          "target_port": "items"
        }
      ],
      "viewport": {},
      "variables": [
        {
          "name": "result_limit",
          "type": "integer",
          "source": "input",
          "description": "Maximum number of results to return.",
          "value": 5,
          "minimum": 1,
          "maximum": 10,
          "expose_to_llm": true
        }
      ]
    }
  },
  {
